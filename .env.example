# Copy this file to ".env" for running Veronica on your own computer.
# Never commit ".env". On Render these values are set in the dashboard
# (your service > Environment), not in a file.

# The password used to open Veronica (at least 8 characters).
# REQUIRED in production: the server will not start without it.
# May be left empty for local development on your own computer.
APP_PASSWORD=

# Where the SQLite database file lives.
# REQUIRED in production, and it must be on a persistent disk.
# On Render: /var/data/veronica.db   (Docker image: /data/veronica.db)
DATABASE_PATH=./data/veronica.db

# The business's time zone (standard IANA name), for example:
# America/Phoenix, America/Los_Angeles, America/Denver, America/Chicago, America/New_York
TZ=America/Chicago

# Port the web server listens on. Render and Docker set this automatically.
PORT=3000

# Optional. Signs login cookies. If empty, Veronica creates a random secret and
# keeps it in the database (recommended). Changing it signs out every device.
SESSION_SECRET=
