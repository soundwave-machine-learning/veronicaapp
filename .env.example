# Copy this file to ".env" and fill in real values. Never commit ".env".

# Port the web server listens on.
PORT=3000

# Where the SQLite database file is stored. On a server, point this at a
# persistent disk/volume (for example /data/veronica.db).
DATABASE_PATH=./data/veronica.db

# The password used to open Veronica. Strongly recommended for any deployed
# copy, because the app holds customer names, phone numbers and addresses.
# Leave empty only for local development on your own computer.
APP_PASSWORD=

# Optional: secret used to sign login cookies. If empty, one is derived from
# APP_PASSWORD. Changing either one signs everybody out.
SESSION_SECRET=

# Time zone of the business. Used by the server to decide how far ahead
# repeating cleanings are created. Example: America/Chicago
TZ=America/New_York

# "production" when deployed.
NODE_ENV=development
